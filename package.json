{
  "name": "sonic-studio",
  "version": "1.0.0",
  "description": "Sonic Studio — музыкальный центр, видеоплеер, soundboard, аудиоредактор, эквалайзер, визуализация и сценический вывод на выбранный дисплей",
  "main": "dist/main/index.js",
  "author": "Sonic Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n RENDERER,ELECTRON -c cyan,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:node && cross-env SONIC_DEV=1 electron .",
    "server": "npm run build:node && node dist/server/standalone.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:node && npm run build:renderer",
    "start": "electron .",
    "test": "npm run build:node && tsc -p tsconfig.test.json && node --test \"dist/**/*.test.js\"",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "express": "4.21.2",
    "music-metadata": "7.14.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.21",
    "@types/ws": "8.18.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "5.8.3",
    "vite": "5.4.19"
  }
}
